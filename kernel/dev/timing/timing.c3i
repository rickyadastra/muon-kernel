module dev::timing;

faultdef WALLCLOCK_NOT_SET, NO_SUPPORTED_TIMER, NO_SUPPORTED_TIMESOURCE;

alias TimerCallbackFn = fn void(TimerEvent*);
alias KernelTime = ulong;

interface Timer {
    fn void set(KernelTime time);
    fn void cancel();

    fn double get_frequency();
    fn KernelTime get_current();
}

struct TimerEvent {
    KernelTime timestamp;
    TimerCallbackFn callback;
    any context;
    bitstruct : char {
        bool isCancelled : 0;
    }
}

interface TimeSource {
	fn KernelTime read();
	fn double get_frequency();
	fn KernelTime delta_to(KernelTime deadline);
}
