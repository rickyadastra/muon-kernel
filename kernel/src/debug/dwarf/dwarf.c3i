module muon::debug::dwarf;

struct Header @packed {
    uint length;
    union {
        uint cieId;
        uint cieOffset;
    }
}

struct CommonInfoEntry @packed {
    inline Header header;
    char version;
    char[*] augmentation;
}

struct FrameDescriptionEntry @packed {
    inline Header header;
    uint initialLocation;
    uint addrRange;
    char augLen;
} 

enum RegRuleKind : const char {
    UNDEFINED,
    SAME_VALUE,
    OFFSET,
}

struct RegRule {
    RegRuleKind kind;
    int offset;
}

struct CfaRule {
    RegId reg;
    ulong offset;
}

bitstruct OpCode : char {
    char low : 0..5;
    char primary : 6..7;
}

enum Instruction : char (OpCode opcode) {
    NO_OP               = (OpCode)0x00,
    CFA_ADVANCE_LOC1    = (OpCode)0x02,
    CFA_ADVANCE_LOC2    = (OpCode)0x03,
    DEF_CFA             = (OpCode)0x0c,
    DEF_CFA_OFFSET      = (OpCode)0x0e,
    CFA_ADVANCE_LOC     = (OpCode)0x40,
    CFA_OFFSET          = (OpCode)0x80,
}

struct UnwindVmState {
    bool initialised;
    uptr loc;
    CfaRule cfa;
    RegRule[MAX_DWARF_REG] regs;
}
