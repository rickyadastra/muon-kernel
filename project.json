{
    "langrev": "1",
    "warnings": [
        "no-unused"
    ],
    "authors": [
        "rickyadastra"
    ],
    "version": "0.4",
    "sources": [
        "kernel/**",
        "boot/*",
        "boot/adapters/*",
        "libs/**"
    ],
    "dependency-search-paths": [
        "boot/boson/lib"
    ],
    "dependencies": [
        "boson_protocol"
    ],
    "test-sources": [
        "test/**"
    ],
    "testfn": "muon::test::run_all",
    "build-dir": "./.build",
    "output": "./.build",
    "panicfn": "muon::panicfn",
    "use-stdlib": false,
    "link-libc": false,
    "no-entry": true,
    "targets": {
        "muon-x64": {
            "type": "executable",
            "name": "muon",
            "extension": ".elf",
            "target": "elf-x64",
            "features": [
                "ARCH_X86_64"
            ],
            "x86cpu": "baseline",
            "linker": "builtin",
            "link-args": [
                "-Tscripts/x86_64.ld",
                "-zmax-page-size=0x1000",
                "-static",
                "-ztext"
            ]
        },
        "muon-x64-symbols": {
            "type": "prepare",
            "exec": [
                "symgen.c3 muon.elf muon.sym"
            ]
        }
    }
}