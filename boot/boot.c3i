module muon::boot;

faultdef INVALID_BOOTLOADER;

const usz MAX_MEMORY_REGIONS = 128;
const usz MAX_MODULES = 32;

enum MemoryRegionType : uint {
    BOOTLOADER,
    AVAILABLE,
    FIRMWARE,
    ACPI,
    MMIO,
    RESERVED,
    KERNEL,
	MODULE,
}

struct MemoryRegion {
    MemoryRegionType type;
    uptr base;
    uptr baseVirt;
    ulong size;
}

enum Bootloader {
	UNKNOWN,
	BOSON,
}

struct MemoryBootContext {
	MemoryRegion[MAX_MEMORY_REGIONS] mapRegions;
	usz mapRegionsCount;
	ulong totalBytes;
}

struct StackBootContext {
	void* base;
	usz size;
}

struct Module {
	uptr address;
	uint size;
	char nameLen;
	char[32] name;
}

macro String Module.get_name(&self) => (String)self.name[:self.nameLen];

struct ModulesBootContext {
	Module[MAX_MODULES] modules;
	usz count;
}

macro Module[] ModulesBootContext.get_modules(&self) => self.modules[:self.count];

struct CommonBootContext @private {
	Bootloader bootloader;
	MemoryBootContext memory;
	StackBootContext stack;
	ModulesBootContext modules;
}

macro @to_boot_context(BootContext #bootCtx, void* #bootParam) {
	$if $feat(BOOT_BOSON):
		if (try @from_boson_bib(#bootCtx, #bootParam)) return;
	$endif
	$if !$feat(BOOT_BOSON):
		$error("No bootloaders were specified.");
	$endif
}

module muon::boot @feat(ARCH_X86_64);

struct BootContext {
	inline CommonBootContext commonCtx;	

	uptr pageTablePtr;
	uptr rsdpAddr;
}
